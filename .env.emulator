# Usado por `npm run dev:emulador`: conecta la app a los emuladores locales (sin tocar tu proyecto real).
VITE_USE_EMULATOR=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-expo-reloj.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-expo-reloj
VITE_FIREBASE_APP_ID=demo-app
VITE_SESSION_ID=expo-reloj
