# Copia este archivo como .env.local y pega la configuración web de tu proyecto Firebase.
# (Consola de Firebase → ⚙ Configuración del proyecto → Tus apps → App web → SDK setup and configuration → Config)
# Estos valores NO son secretos: la seguridad está en firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Sesión única de la exposición
VITE_SESSION_ID=expo-reloj
